  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Adds a view to a table: grid (the spreadsheet), entry (fast input on a phone, prefilled from the last row with the same match values), list (grouped cards) or chart (bars or a line of an aggregate).",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "base": {
          "description": "name or id of the base",
          "type": "string",
        },
        "config": {
          "additionalProperties": false,
          "description": "the view settings, fields given by name; null clears a setting",
          "properties": {
            "agg": {
              "description": "chart",
              "enum": [
                "count",
                "sum",
                "avg",
                "max",
                "min",
              ],
              "type": "string",
            },
            "bucket": {
              "anyOf": [
                {
                  "enum": [
                    "day",
                    "week",
                    "month",
                  ],
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
              "description": "chart: how dates are grouped",
            },
            "color": {
              "anyOf": [
                {
                  "type": "string",
                },
                {
                  "description": "clears it: one series",
                  "type": "null",
                },
              ],
              "description": "chart: a choice field that splits the series",
            },
            "fields": {
              "description": "entry: the fields to fill, in order",
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "filter": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "field": {
                      "type": "string",
                    },
                    "text": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "field",
                    "text",
                  ],
                  "type": "object",
                },
                {
                  "type": "null",
                },
              ],
              "description": "grid: rows whose field contains the text; null clears it",
            },
            "group": {
              "anyOf": [
                {
                  "type": "string",
                },
                {
                  "description": "clears it: no groups",
                  "type": "null",
                },
              ],
              "description": "list: the field to group by",
            },
            "hidden": {
              "description": "grid: hidden fields",
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "kind": {
              "description": "chart",
              "enum": [
                "bar",
                "line",
              ],
              "type": "string",
            },
            "match": {
              "description": "entry: the fields that identify "last time" for prefilling, in order, such as ["Exercise"]; with two or more, the first repeats its last occurrence row by row, such as ["Session", "Exercise"]",
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "rolling": {
              "anyOf": [
                {
                  "maximum": 90,
                  "minimum": 2,
                  "type": "integer",
                },
                {
                  "type": "null",
                },
              ],
              "description": "line chart: rolling average over N days; null for none",
            },
            "show": {
              "description": "list: the fields shown under the title",
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "sort": {
              "anyOf": [
                {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "dir": {
                        "enum": [
                          "asc",
                          "desc",
                        ],
                        "type": "string",
                      },
                      "field": {
                        "type": "string",
                      },
                    },
                    "required": [
                      "field",
                      "dir",
                    ],
                    "type": "object",
                  },
                  "type": "array",
                },
                {
                  "type": "null",
                },
              ],
              "description": "grid: the sort keys in order, each next one breaking the ties of the ones before, such as [{"field": "Date", "dir": "desc"}, {"field": "Set", "dir": "asc"}]",
            },
            "title": {
              "anyOf": [
                {
                  "type": "string",
                },
                {
                  "description": "clears it: the first text field",
                  "type": "null",
                },
              ],
              "description": "list: the field shown as the title",
            },
            "x": {
              "anyOf": [
                {
                  "type": "string",
                },
                {
                  "description": "clears it: no x",
                  "type": "null",
                },
              ],
              "description": "chart: the x field, often a date",
            },
            "y": {
              "anyOf": [
                {
                  "type": "string",
                },
                {
                  "description": "clears it: no y",
                  "type": "null",
                },
              ],
              "description": "chart: the aggregated field, except for count",
            },
          },
          "type": "object",
        },
        "name": {
          "minLength": 1,
          "type": "string",
        },
        "table": {
          "description": "name or id of the table",
          "type": "string",
        },
        "type": {
          "enum": [
            "grid",
            "entry",
            "list",
            "chart",
          ],
          "type": "string",
        },
      },
      "required": [
        "base",
        "table",
        "name",
        "type",
        "config",
      ],
      "type": "object",
    },
    "name": "create_view",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
        },
      },
      "required": [
        "id",
      ],
      "type": "object",
    },
    "title": "Create a view",
  },
