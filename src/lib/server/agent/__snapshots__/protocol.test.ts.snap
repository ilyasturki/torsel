                  "number",
                  "currency",
                  "percent",
                  "rating",
                  "duration",
                  "date",
                  "datetime",
                  "choice",
                  "choices",
                  "check",
                  "link",
                  "url",
                  "email",
                  "phone",
                ],
                "type": "string",
              },
              "unit": {
                "description": "number: shown after it, such as kg or km",
                "type": "string",
              },
            },
            "required": [
              "name",
              "type",
            ],
            "type": "object",
          },
          "minItems": 1,
          "type": "array",
