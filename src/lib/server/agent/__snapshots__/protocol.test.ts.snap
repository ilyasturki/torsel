        },
        "formula": {
          "description": "for a formula field: an SQLite expression over the fields of the row, names in double quotes, such as "Weight" * (1 + "Reps" / 30.0). Divide by 30.0 rather than 30: SQLite divides integers as integers. An aggregate needs OVER, such as SUM("Weight") OVER () for the column total on every row.",
          "type": "string",
        },
        "grouping": {
          "description": "number: false for a year, an ID or a code, so 12345 never reads 12,345",
