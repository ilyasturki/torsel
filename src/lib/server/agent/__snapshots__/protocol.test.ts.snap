      "readOnlyHint": false,
    },
    "description": "Adds a field to a table, a computed one (formula) included, last unless a position is given. SQLite checks a formula first. Field names are unique in a table.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "base": {
          "description": "name or id of the base",
          "type": "string",
        },
        "choices": {
          "description": "for a choice or choices field, in order: a name, or {name, color} to set its colour (gray, orange, amber, green, teal, blue, violet, pink); a name alone keeps the colour it has, a new one takes the next",
          "items": {
            "anyOf": [
              {
                "type": "string",
              },
              {
                "additionalProperties": false,
                "properties": {
                  "color": {
                    "enum": [
                      "gray",
                      "orange",
                      "amber",
                      "green",
                      "teal",
                      "blue",
                      "violet",
                      "pink",
                    ],
                    "type": "string",
                  },
                  "name": {
                    "minLength": 1,
                    "type": "string",
                  },
                },
                "required": [
                  "name",
                  "color",
                ],
                "type": "object",
              },
            ],
          },
          "type": "array",
        },
        "currency": {
          "description": "currency, and a formula shown as currency: the ISO code, such as EUR or USD",
          "pattern": "^[A-Z]{3}$",
          "type": "string",
        },
        "dateStyle": {
          "description": "date, datetime, and a formula shown as a date: short reads "28 Dec" (with the year when not this one), numeric "12/28/2026" in the reader's order, weekday "Mon, Dec 28", long "December 28, 2026", iso "2026-12-28"; short when left out",
          "enum": [
            "short",
            "numeric",
            "weekday",
            "long",
            "iso",
          ],
          "type": "string",
        },
        "decimals": {
          "description": "number, currency, percent, and a formula shown as one: the decimals shown; leave out for automatic",
          "maximum": 6,
          "minimum": 0,
          "type": "integer",
        },
        "description": {
          "description": "one sentence saying what the field holds",
          "type": "string",
        },
        "formula": {
          "description": "for a formula field: an SQLite expression over the fields of the row, names in double quotes, such as "Weight" * (1 + "Reps" / 30.0). Divide by 30.0 rather than 30: SQLite divides integers as integers. An aggregate needs OVER, such as SUM("Weight") OVER () for the column total on every row. Sheets names work too: IF, IFS, IFERROR, LEFT, RIGHT, MID, LEN, CONCATENATE, TEXTJOIN, SUBSTITUTE, PROPER, FIND, SEARCH, REGEXMATCH, REGEXEXTRACT, REGEXREPLACE, TODAY(), NOW(), YEAR, MONTH, DAY, WEEKDAY, ISOWEEKNUM, DAYS, DATEDIF, EDATE, EOMONTH, NETWORKDAYS, INT, ROUNDUP, ROUNDDOWN, AVERAGE, COUNTA, COUNTUNIQUE, COUNTIF, SUMIF, AVERAGEIF; dates are YYYY-MM-DD text, so DAYS(TODAY(), "Date") counts days where TODAY() - "Date" does not. "Link"."Field" reads a field of the row a link field points to. An aggregate over a table that links here folds its linked rows: SUM("Sets"."Weight" * "Sets"."Reps"), COUNT("Sets"); it needs that table to link here through one field. A name is the row's own field first, then a linking table.",
          "type": "string",
        },
        "grouping": {
          "description": "number: false for a year, an ID or a code, so 12345 never reads 12,345",
          "type": "boolean",
        },
        "max": {
          "description": "rating: the highest score, 5 when left out",
          "maximum": 10,
          "minimum": 2,
          "type": "integer",
        },
        "min": {
          "description": "rating: the lowest score, 0 or 1",
          "maximum": 1,
          "minimum": 0,
          "type": "integer",
        },
        "name": {
          "minLength": 1,
          "type": "string",
        },
        "position": {
          "description": "where it goes among the fields, 1 for first",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer",
        },
        "result": {
          "description": "formula: how its result reads; percent reads the result as points, 25 for 25%; automatic when left out",
          "enum": [
            "number",
            "currency",
            "percent",
            "date",
          ],
          "type": "string",
        },
        "seconds": {
          "description": "duration: shown as h:mm:ss rather than h:mm",
          "type": "boolean",
        },
        "step": {
          "description": "number: the step of the entry form's plus and minus; rating: 0.5 for half points",
          "exclusiveMinimum": 0,
          "type": "number",
        },
        "table": {
          "description": "name or id of the table",
          "type": "string",
        },
        "target": {
          "description": "for a link field: the linked table",
          "type": "string",
        },
        "type": {
          "description": "text; longtext for notes over several lines; number for counts, measures and years (a year without grouping); currency for money; percent; rating for a score on a scale, such as stars or out of 10; duration for a length of time; date; datetime when the time of day matters; choice for one label out of a few; choices for several labels, such as tags; check for yes or no; link to a row of another table; url; email; phone; formula for a computed value",
          "enum": [
            "text",
            "longtext",
            "number",
            "currency",
            "percent",
            "rating",
            "duration",
            "date",
            "datetime",
            "choice",
            "choices",
            "check",
            "link",
            "url",
            "email",
            "phone",
            "image",
            "formula",
          ],
          "type": "string",
        },
        "unit": {
          "description": "number: shown after it, such as kg or km",
          "type": "string",
        },
      },
      "required": [
        "name",
        "type",
        "base",
        "table",
      ],
      "type": "object",
    },
    "name": "add_field",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
        },
      },
      "required": [
        "id",
      ],
      "type": "object",
    },
    "title": "Add a field",
  },
