        "view": {
          "description": "name or id of the view to copy",
          "type": "string",
        },
      },
      "required": [
        "base",
        "table",
      ],
      "type": "object",
    },
    "name": "duplicate",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
