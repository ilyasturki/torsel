              },
              "type": "array",
            },
            "rolling": {
              "anyOf": [
                {
                  "maximum": 90,
                  "minimum": 2,
                  "type": "integer",
                },
                {
                  "type": "null",
                },
              ],
              "description": "line chart: rolling average over N days; null for none",
            },
            "show": {
              "description": "list: the fields shown under the title",
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "sort": {
              "anyOf": [
                {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "dir": {
                        "enum": [
                          "asc",
                          "desc",
                        ],
                        "type": "string",
                      },
                      "field": {
                        "type": "string",
                      },
                    },
                    "required": [
                      "field",
                      "dir",
                    ],
                    "type": "object",
                  },
                  "type": "array",
                },
                {
                  "type": "null",
                },
              ],
              "description": "grid: the sort keys in order, each next one breaking the ties of the ones before, such as [{"field": "Date", "dir": "desc"}, {"field": "Set", "dir": "asc"}]",
            },
            "title": {
              "anyOf": [
                {
                  "type": "string",
                },
                {
                  "description": "clears it: the first text field",
                  "type": "null",
                },
              ],
              "description": "list: the field shown as the title",
            },
            "x": {
              "anyOf": [
                {
                  "type": "string",
                },
                {
                  "description": "clears it: no x",
                  "type": "null",
                },
              ],
              "description": "chart: the x field, often a date",
            },
            "y": {
              "anyOf": [
                {
                  "type": "string",
                },
                {
                  "description": "clears it: no y",
                  "type": "null",
                },
              ],
              "description": "chart: the aggregated field, except for count",
            },
          },
          "type": "object",
        },
        "name": {
          "minLength": 1,
          "type": "string",
        },
        "table": {
          "description": "name or id of the table",
          "type": "string",
        },
        "view": {
          "description": "name or id of the view",
          "type": "string",
        },
      },
      "required": [
        "base",
        "table",
        "view",
      ],
      "type": "object",
    },
    "name": "update_view",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "updated": {
          "type": "string",
        },
      },
      "required": [
        "updated",
      ],
      "type": "object",
    },
    "title": "Change a view",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Moves a field among the fields of its table, or a view among the tabs of its table, to a position: 1 for first.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "base": {
