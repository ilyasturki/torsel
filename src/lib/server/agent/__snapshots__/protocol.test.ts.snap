          "type": "string",
        },
        "field": {
          "description": "name or id of the field to move",
          "type": "string",
        },
        "position": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer",
        },
        "table": {
          "description": "name or id of the table",
          "type": "string",
        },
        "view": {
          "description": "name or id of the view to move",
          "type": "string",
        },
      },
      "required": [
