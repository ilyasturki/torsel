          "type": "number",
        },
        "changed": {
          "type": "number",
        },
        "problem": {
          "type": "string",
        },
        "removed": {
          "type": "number",
        },
      },
      "type": "object",
    },
    "title": "Refresh a linked table",
  },
  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Changes how often a linked table refreshes (every) and what becomes of rows gone from the source (missing); stop: true stops syncing, which keeps the rows and makes every field editable, and cannot be undone.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "every": {
          "enum": [
            "manual",
            "hour",
            "day",
          ],
          "type": "string",
        },
        "missing": {
          "enum": [
            "remove",
            "keep",
          ],
          "type": "string",
        },
        "stop": {
          "type": "boolean",
        },
        "table": {
          "description": "name or id of the linked table",
          "type": "string",
        },
      },
      "required": [
        "table",
      ],
      "type": "object",
    },
    "name": "update_source",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "updated": {
          "type": "string",
        },
      },
      "required": [
        "updated",
      ],
      "type": "object",
    },
    "title": "Change a linked table’s source",
  },
]
`;
