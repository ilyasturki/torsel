    },
    "description": "Creates a table with its fields and its Grid and Entry views. Formulas come afterwards through add_field, once the fields they read are in place. Table names are unique in a base, field names in a table.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "base": {
          "description": "name or id of the base; leave it out for the default base, unless the person names one",
          "type": "string",
        },
        "fields": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "choices": {
                "description": "for a choice or choices field",
                "items": {
                  "type": "string",
                },
                "type": "array",
              },
              "currency": {
                "description": "currency, and a formula shown as currency: the ISO code, such as EUR or USD",
                "pattern": "^[A-Z]{3}$",
                "type": "string",
              },
              "dateStyle": {
                "description": "date, datetime, and a formula shown as a date: short reads "28 Dec" (with the year when not this one), numeric "12/28/2026" in the reader's order, weekday "Mon, Dec 28", long "December 28, 2026", iso "2026-12-28"; short when left out",
                "enum": [
                  "short",
                  "numeric",
                  "weekday",
                  "long",
                  "iso",
                ],
                "type": "string",
              },
              "decimals": {
                "description": "number, currency, percent, and a formula shown as one: the decimals shown; leave out for automatic",
                "maximum": 6,
                "minimum": 0,
                "type": "integer",
              },
              "description": {
                "description": "one sentence saying what the field holds",
                "type": "string",
              },
              "grouping": {
                "description": "number: false for a year, an ID or a code, so 12345 never reads 12,345",
                "type": "boolean",
              },
              "max": {
                "description": "rating: the highest score, 5 when left out",
                "maximum": 10,
                "minimum": 2,
                "type": "integer",
              },
              "min": {
                "description": "rating: the lowest score, 0 or 1",
                "maximum": 1,
                "minimum": 0,
                "type": "integer",
              },
              "name": {
                "minLength": 1,
                "type": "string",
              },
              "result": {
