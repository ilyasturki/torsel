          "type": "array",
        },
        "table": {
          "description": "name or id of the table",
          "type": "string",
        },
        "view": {
          "description": "name or id of the view to copy",
          "type": "string",
        },
      },
      "required": [
        "base",
        "table",
      ],
      "type": "object",
    },
    "name": "duplicate",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "added": {
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "created": {
          "type": "string",
        },
      },
      "type": "object",
    },
    "title": "Duplicate a table, field, view or rows",
  },
  {
    "annotations": {
