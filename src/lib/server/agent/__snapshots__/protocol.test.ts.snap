    },
    "description": "Copies a table with its fields, views and rows; or, given field, view or rows, that field with its values, that view with its settings, or those rows, each copy placed right after what it copies.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "base": {
          "description": "name or id of the base",
          "type": "string",
        },
        "field": {
          "description": "name or id of the field to copy",
          "type": "string",
        },
        "name": {
          "description": "the name of a copied table, field or view; "<name> copy" when left out",
          "minLength": 1,
          "type": "string",
        },
        "rows": {
          "description": "ids of the rows to copy, from _id",
          "items": {
            "type": "string",
