        },
        "min": {
          "description": "rating: the lowest score, 0 or 1",
          "maximum": 1,
          "minimum": 0,
          "type": "integer",
        },
        "name": {
          "minLength": 1,
          "type": "string",
        },
        "result": {
          "description": "formula: how its result reads; percent reads the result as points, 25 for 25%; automatic when left out",
          "enum": [
            "number",
            "currency",
            "percent",
            "date",
          ],
          "type": "string",
        },
        "seconds": {
          "description": "duration: shown as h:mm:ss rather than h:mm",
          "type": "boolean",
        },
        "step": {
          "description": "number: the step of the entry form's plus and minus; rating: 0.5 for half points",
          "exclusiveMinimum": 0,
          "type": "number",
        },
        "table": {
          "description": "name or id of the table",
          "type": "string",
        },
        "target": {
          "description": "for a link field: the linked table",
          "type": "string",
        },
        "type": {
          "description": "text; longtext for notes over several lines; number for counts, measures and years (a year without grouping); currency for money; percent; rating for a score on a scale, such as stars or out of 10; duration for a length of time; date; datetime when the time of day matters; choice for one label out of a few; choices for several labels, such as tags; check for yes or no; link to a row of another table; url; email; phone; formula for a computed value",
          "enum": [
            "text",
            "longtext",
            "number",
            "currency",
            "percent",
            "rating",
            "duration",
            "date",
            "datetime",
            "choice",
            "choices",
            "check",
            "link",
            "url",
            "email",
            "phone",
            "formula",
          ],
          "type": "string",
        },
        "unit": {
          "description": "number: shown after it, such as kg or km",
          "type": "string",
        },
      },
      "required": [
        "name",
        "type",
        "base",
        "table",
      ],
      "type": "object",
    },
    "name": "add_field",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
        },
      },
      "required": [
