{
	"name": "torsel",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:app": "BUILD_TARGET=app vite dev --port 5173 --strictPort",
		"build:server": "vite build",
		"build:app": "BUILD_TARGET=app vite build",
		"app:sync": "bun run build:app && cap sync android",
		"app:install": "bun run app:sync && cd android && ./gradlew installDebug",
		"start": "node build/server/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:e2e": "node scripts/test-e2e.ts",
		"format": "prettier --check .",
		"format:write": "prettier --write .",
		"lint": "oxlint",
		"nix:deps-hash": "nix/refresh-deps-hash.sh",
		"db:generate": "drizzle-kit generate",
		"account:create": "node scripts/account.ts create",
		"account:list": "node scripts/account.ts list",
		"account:password": "node scripts/account.ts password",
		"account:delete": "node scripts/account.ts delete"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.6.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"drizzle-kit": "1.0.0-rc.4",
		"fake-indexeddb": "^6.2.6",
		"oxlint": "^1.90.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^1.3.0",
		"@capacitor/android": "^8.6.0",
		"@capacitor/app": "^8.1.2",
		"@capacitor/core": "^8.6.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@lucide/svelte": "^1.63.0",
		"@modelcontextprotocol/server": "^2.4.0",
		"@sqlite.org/sqlite-wasm": "^3.54.1-build1",
		"bits-ui": "^2.20.2",
		"drizzle-orm": "1.0.0-rc.4",
		"idb": "^8.0.4",
		"zod": "^4.6.7"
	}
}
