DATABASE_PATH=.data/torsel.db
# MIGRATIONS_DIR=drizzle
# ANTHROPIC_API_KEY=
# TORSEL_AI_MODEL=
# Assistant messages in any 24 hours, per account and across the instance; 0 lifts either cap.
# TORSEL_AI_DAILY_LIMIT=30
# TORSEL_AI_INSTANCE_DAILY_LIMIT=300
# Accounts that skip both caps, by e-mail, comma-separated.
# TORSEL_AI_UNLIMITED=
# Pins emailed links and the Google redirect, and is required for both in production: https://torsel.example.com
# ORIGIN=http://192.168.1.50:3000
# CORS_ORIGINS=

# Sign-up stays closed unless this is on. `bun run account:create` works either way.
# TORSEL_PUBLIC_SIGNUP=1
# Without a key or a sender, sign-in mail goes to the server log instead, code and link included.
# BREVO_API_KEY=
# TORSEL_EMAIL_FROM=no-reply@example.com
# TORSEL_EMAIL_FROM_NAME=Torsel
# Google sign-in stays hidden without both. The redirect URI is <ORIGIN>/api/auth/google.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
